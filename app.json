{
  "expo": {
    "name": "TodoApp",
    "slug": "TodoApp",
    "owner": "park1318",
    "scheme": "todoapp",
    "originalFullName": "@park1318/TodoApp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.park1318.todoapp",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "Bluetooth is required for connection with ESP32 ",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth is required for connection with ESP32 "
      }
    },
    "android": {
      "package": "com.park1318.todoapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "todoapp",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow App to connect to ESP32",
          "bluetoothPeripheralPermission": "Allow App to connect to ESP32"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "12b2225a-9c0b-47b8-b4be-bf17242154db"
      }
    }
  }
}